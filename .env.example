# Copy to .env and fill in. Never commit .env.
# One OpenRouter key runs everything: Claude (chat) and Jev (decisions).
OPENROUTER_API_KEY=

# Model IDs as listed on openrouter.ai/models (verified Nov 2026)
MODEL_FAST=anthropic/claude-haiku-5.5
MODEL_DEEP=anthropic/claude-sonnet-5.5
MODEL_JEV=typesafe/jev-1.14

# Optional: call TypeSafe directly instead of through OpenRouter
TYPESAFE_API_KEY=
# Set JEV=off to skip Jev (keyword fallback is used instead)
JEV=

PORT=3000
# Set MOCK=1 to run without any API calls
MOCK=
